  {
   "fieldname": "sb_otp",
   "fieldtype": "Section Break",
   "label": "Tasdiqlash kodi (OTP)"
  },
  {
   "fieldname": "otp_provider",
   "fieldtype": "Select",
   "label": "OTP provayderi",
   "options": "Test (konsol)\nTelegram Bot\nTelegram Gateway",
   "default": "Test (konsol)",
   "description": "Telegram Bot — o'z botimiz (bepul): mijoz botda raqamini bir marta yuboradi, keyin kodlar darhol keladi. Telegram Gateway — pullik, botsiz. Test — kod bench terminaliga yoziladi."
  },
  {
   "fieldname": "telegram_gateway_token",
   "fieldtype": "Password",
   "label": "Telegram Gateway API token",
   "depends_on": "eval:doc.otp_provider=='Telegram Gateway'",
   "description": "gateway.telegram.org → API token"
  },
  {
   "fieldname": "cb_otp",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "otp_length",
   "fieldtype": "Int",
